# Shinkansen RSS Translator — 環境變數範本
# 複製成 .env 後填入。.env 已被 .gitignore 忽略,金鑰不會進 git。

# Gemini API 金鑰(用 Gemini 引擎時必填;純 Google 翻譯引擎可留空)
# 也可以之後在 web 介面「設定」頁填,設定頁的值優先於此。
GEMINI_API_KEY=

# 監聽埠(預設 8088)
PORT=8088

# 排程:多久跑一次「處理所有啟用中的 feed」(cron 語法;留空 = 不自動排程)
POLL_CRON=*/15 * * * *

# SQLite 資料庫路徑(Docker 內預設 /app/data/…;本機不設則放專案 data/)
# DB_PATH=/app/data/shinkansen-feed.sqlite
