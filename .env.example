# Shinkansen RSS Translator — 環境變數範本(可選)
# 複製成 .env。這裡只放基礎設定;Gemini 金鑰與更新頻率改在 web 介面「設定」頁設定。

# 監聽埠(預設 8088)
PORT=8088

# 首次啟動的預設更新頻率(cron)。DB 尚未設過時採用;之後以 web 設定頁為準。留空 = 不自動更新。
POLL_CRON=*/15 * * * *

# SQLite 資料庫路徑(Docker 內預設 /app/data/…;本機不設則放專案 data/)
# DB_PATH=/app/data/shinkansen-feed.sqlite

# 網頁介面與 API 的登入密碼(HTTP Basic Auth,帳號隨意)。
# 不設 = 不認證,僅建議在受信任內網使用。譯後 RSS(/rss/…)一律免認證,閱讀器才抓得到。
# AUTH_PASSWORD=請換成你的密碼
